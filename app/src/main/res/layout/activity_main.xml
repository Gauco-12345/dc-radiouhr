<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/clockPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#BBBBBB"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="--:--"
            android:textColor="#FFFFFF"
            android:textSize="96sp" />

        <de.datacreate.radiouhr.ClockView
            android:id="@+id/clockView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:visibility="gone" />


        <LinearLayout
            android:id="@+id/weatherBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/weatherRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvWeatherIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFD27A"
                        android:textSize="26sp" />

                    <TextView
                        android:id="@+id/tvTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:text="–°"
                        android:textColor="#FFFFFF"
                        android:textSize="36sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWeatherInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxWidth="150dp"
                    android:maxLines="3"
                    android:textColor="#999999"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/wxDivider"
                android:layout_width="1dp"
                android:layout_height="56dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"
                android:background="#44FFFFFF" />

            <LinearLayout
                android:id="@+id/forecastRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="9"
            android:textColor="#DDDDDD"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/radioPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <de.datacreate.radiouhr.DialView
            android:id="@+id/dialView"
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:singleLine="true"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/favScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/favRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/favGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.85"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView android:id="@+id/btnPlay" style="@style/IconBtn" android:layout_weight="1.4"
                android:padding="12dp" android:src="@drawable/ic_play" android:visibility="gone" />

            <FrameLayout android:id="@+id/btnTimer" style="@style/IconBtn" android:padding="0dp">
                <ImageView
                    android:id="@+id/timerIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_timer" />
                <TextView
                    android:id="@+id/tvTimerBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|right"
                    android:layout_margin="1dp"
                    android:textColor="#FF8A3D"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView android:id="@+id/btnAdd" style="@style/IconBtn" android:src="@drawable/ic_add" />
            <ImageView android:id="@+id/btnNight" style="@style/IconBtn" android:src="@drawable/ic_moon" />
            <ImageView android:id="@+id/btnSettings" style="@style/IconBtn" android:src="@drawable/ic_tune" android:visibility="gone" />

            <de.datacreate.radiouhr.KnobView
                android:id="@+id/knob"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginLeft="10dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

    <ImageView
        android:id="@+id/btnGear"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|right"
        android:layout_margin="4dp"
        android:alpha="0.6"
        android:padding="11dp" />
</FrameLayout>
